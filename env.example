Ejemplo usado en el proyecto:

1: .env (En la raíz del proyecto)
# Configuración del Servidor
PORT=3000

# Configuración de la Base de Datos
DB_NAME=tasks_users_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_DIALECT=mysql

2: src/config/database.js (Refactorizado)
import { Sequelize } from "sequelize";
import "dotenv/config"; // Carga automáticamente las variables del archivo .env

export const sequelize = new Sequelize(
    process.env.DB_NAME,
    process.env.DB_USER,
    process.env.DB_PASSWORD,
    {
        host: process.env.DB_HOST,
        dialect: process.env.DB_DIALECT,
    }
);

export const startDB = async () => {
    try {
        await sequelize.authenticate();
        await sequelize.sync({ force: false });
        console.log("Conexión a la base de datos está lista");
    } catch (error) {
        console.error("No se pudo conectar a la base de datos", error);
    }
};

3: app.js (Refactorizado)
import express from 'express';
import 'dotenv/config'; // Asegura que las variables estén disponibles en todo el servidor
import { startDB } from './src/config/database.js';

const app = express();

// Leer el puerto desde .env o tomar el puerto 3000 por defecto
const PORT = process.env.PORT || 3000;

app.use(express.json());

// Tus rutas de usuarios y tareas...

app.listen(PORT, () => {
    startDB();
    console.log(`Servidor listo en el puerto ${PORT}`);
});